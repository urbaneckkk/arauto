# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O ".env" nunca vai para o Git (está no .gitignore) e nunca deve ser colado em chat ou issue.

# Chave da API da Anthropic. Crie uma só para o ARAUTO, em um workspace próprio do console, com
# limite mensal de gasto (recomendado: US$ 30, um pouco acima de MAX_USD_MES).
ANTHROPIC_API_KEY=

# Postgres local (docker compose up -d). Sem senha, só em 127.0.0.1. Em produção (Railway) é outro.
DATABASE_URL=postgres://arauto@127.0.0.1:5433/arauto

# Travas de custo, em dólares (briefing). A execução para quando a próxima chamada estouraria uma delas.
MAX_USD_POR_EXECUCAO=1
MAX_USD_MES=25

# economico (até 3 buscas) ou padrao (até 8 buscas). Veja PLAN.md, seção 3.3.
PERFIL_CUSTO=padrao

# Interruptor geral: com 1, nenhuma chamada paga é feita.
GASTOS_PAUSADOS=0

# --- Servidor (Etapa 2) ---
# Porta e endereço. No Railway, a porta vem pronta.
PORT=3000
# Quantos proxies confiáveis ficam na frente do servidor: 0 em casa, 1 no Railway (⚠ confirmar).
# Valor maior que o real deixa o cliente forjar o IP e escapar do limite por IP.
CONFIAR_PROXY_SALTOS=0
# Origens extras aceitas pelo CORS, separadas por vírgula (a própria web e as cascas já são aceitas).
ORIGENS_PERMITIDAS=
# "Atualizar agora": no máximo ATUALIZACOES_POR_DIA por dia, com INTERVALO_ATUALIZACAO_MIN entre elas.
ATUALIZACOES_POR_DIA=3
INTERVALO_ATUALIZACAO_MIN=30
# Dias sem uso até um aparelho pareado precisar parear de novo.
TOKEN_INATIVO_DIAS=90
# 0 desliga o briefing automático das 06:00 (a API continua de pé). Útil para desenvolver.
AGENDADOR_LIGADO=1
