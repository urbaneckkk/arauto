{
  "name": "arauto",
  "version": "0.0.0",
  "private": true,
  "description": "ARAUTO: briefing diário de notícias em português simples, com tema visual que muda conforme a notícia do dia.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present test",
    "segredos": "node scripts/verificar-segredos.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "verificar": "pnpm segredos && pnpm test:scripts && pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "brief:gerar": "pnpm --silent build && node --env-file-if-exists=.env packages/server/dist/cli/gerar.js",
    "brief:ver": "pnpm --silent build && node --env-file-if-exists=.env packages/server/dist/cli/ver.js",
    "db:migrar": "pnpm --silent build && node --env-file-if-exists=.env packages/server/dist/cli/migrar.js",
    "tema:testar": "pnpm --silent build && node --env-file-if-exists=.env packages/server/dist/cli/tema-testar.js",
    "hooks:instalar": "git config core.hooksPath .githooks",
    "web:dev": "pnpm --filter @arauto/web exec vite",
    "site:exportar": "node scripts/exportar-site.mjs --estado saida/estado-local.json --saida packages/web/public/briefing",
    "publicacao:conferir": "node scripts/conferir-publicacao.mjs packages/web/dist",
    "automacao:ativar": "node scripts/ativar-automacao.mjs",
    "automacao:desativar": "node scripts/ativar-automacao.mjs --desativar"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:"
  }
}
