{
  "name": "@arauto/server",
  "version": "0.0.0",
  "private": true,
  "description": "Pipeline do briefing, agendador e API. Etapa 1: o pipeline e os comandos de linha.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "brief:gerar": "node --env-file-if-exists=../../.env dist/cli/gerar.js",
    "brief:ver": "node --env-file-if-exists=../../.env dist/cli/ver.js",
    "db:migrar": "node --env-file-if-exists=../../.env dist/cli/migrar.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@arauto/core": "workspace:*",
    "fast-xml-parser": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
